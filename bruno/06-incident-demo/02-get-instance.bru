meta {
  name: Find the process instance
  type: http
  seq: 2
}

post {
  url: {{camundaRest}}/process-instances/search
  body: json
  auth: none
}

body:json {
  {
    "filter": {
      "processDefinitionId": "bikeLeasingProcess",
      "variables": [
        { "name": "applicationId", "value": "\"{{applicationId}}\"" }
      ]
    }
  }
}

script:pre-request {
  // Camunda 8 has no business key: the applicationId travels as a process variable, so we look the
  // instance up by variable. The v2 search API reads from Elasticsearch; poll until it is indexed.
  const id = bru.getVar("applicationId");
  await pollSearch("/process-instances/search",
    { filter: { processDefinitionId: "bikeLeasingProcess",
      variables: [{ name: "applicationId", value: `"${id}"` }] } },
    (b) => b && Array.isArray(b.items) && b.items.length > 0 && b.items[0].processInstanceKey != null);
}

assert {
  res.status: eq 200
  res.body.items[0].processInstanceKey: isDefined
}

vars:post-response {
  processInstanceKey: res.body.items[0].processInstanceKey
}
