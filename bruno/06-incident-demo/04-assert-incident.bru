meta {
  name: Assert an incident was raised on the order task
  type: http
  seq: 4
}

post {
  url: {{camundaRest}}/incidents/search
  body: json
  auth: none
}

body:json {
  {
    "filter": {
      "processInstanceKey": "{{processInstanceKey}}",
      "state": "ACTIVE",
      "errorType": "JOB_NO_RETRIES"
    }
  }
}

script:pre-request {
  // The order job retries 3 times, 10s apart, before Zeebe raises the incident at 0 retries.
  // Wait out the retry window (plus Elasticsearch indexing) so the incident exists by the time we query.
  await new Promise((resolve) => setTimeout(resolve, 40000));
}

assert {
  res.status: eq 200
  res.body.items: length 1
  res.body.items[0].errorType: eq JOB_NO_RETRIES
  res.body.items[0].elementId: eq serviceTask_orderBike
}

vars:post-response {
  incidentKey: res.body.items[0].incidentKey
  failedJobKey: res.body.items[0].jobKey
}
