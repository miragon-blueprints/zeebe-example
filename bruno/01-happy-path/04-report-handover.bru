meta {
  name: Dealer reports the bike handover
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/report-handover
  body: none
  auth: none
}

script:pre-request {
  // sign -> fork (insure + order bike) -> join -> handover wait state. The order worker sets
  // ORDERED + orderId; once we see that, the token is at (or moving to) the handover catch event,
  // and the message publish buffers (10s TTL) until the subscription opens.
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
}

assert {
  res.status: eq 202
}
