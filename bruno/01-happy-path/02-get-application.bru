meta {
  name: The application is being processed
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.applicationId === id);
}

assert {
  res.status: eq 200
  res.body.applicationId: eq {{applicationId}}
}
