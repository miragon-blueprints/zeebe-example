meta {
  name: The application is being processed
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  // validate -> DMN -> send-contract run through the async job workers
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 200
  res.body.applicationId: eq {{applicationId}}
}
