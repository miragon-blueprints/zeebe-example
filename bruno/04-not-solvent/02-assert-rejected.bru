meta {
  name: The DMN rejected the application
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  // validate -> DMN (age < 18 => not solvent) -> send-rejection runs async
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 200
  res.body.status: eq REJECTED
}
