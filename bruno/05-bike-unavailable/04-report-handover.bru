meta {
  name: Dealer reports the bike handover
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/report-handover
  body: none
  auth: none
}

script:pre-request {
  // re-order the alternative -> join -> handover wait state. Gate on the re-order having produced
  // ORDERED + orderId before publishing the handover message.
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.status === "ORDERED" && b.orderId != null);
}

assert {
  res.status: eq 202
}
