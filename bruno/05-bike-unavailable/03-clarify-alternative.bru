meta {
  name: Clarify an acceptable alternative bike
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/clarify-alternative
  body: json
  auth: none
}

body:json {
  {
    "alternativeFound": true,
    "bikeId": "BIKE-901",
    "bikeModel": "Gravel Explorer 901"
  }
}

script:pre-request {
  // sign -> order (out of stock) -> parks on the clarify-alternative user task. This endpoint
  // *completes* that user task and 409s if it is not yet searchable, so gate on the inbox (backed
  // by the same Zeebe user-task search) showing our application before completing it.
  const id = bru.getVar("applicationId");
  await pollApp("/api/tasks/clarify-alternative",
    (b) => Array.isArray(b) && b.some((t) => t.applicationId === id));
}

assert {
  res.status: eq 202
}

docs {
  The recommended, domain-routed completion path: this endpoint persists the chosen
  alternative on the aggregate before completing the user task, so the captured data
  reaches the domain model.
}
