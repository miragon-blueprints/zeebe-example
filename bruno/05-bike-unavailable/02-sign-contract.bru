meta {
  name: Customer signs the contract
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  // Gate on the send-contract worker having set contractId so the contract-signed message correlates.
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.contractId != null);
}

assert {
  res.status: eq 202
}
