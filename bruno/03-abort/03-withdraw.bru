meta {
  name: Customer withdraws the application
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/withdraw
  body: none
  auth: none
}

script:pre-request {
  // let the bike order + insurance complete so there is something to compensate
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 202
}
