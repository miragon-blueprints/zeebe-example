meta {
  name: Customer signs the contract
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}/sign-contract
  body: none
  auth: none
}

script:pre-request {
  // The send-contract worker sets contractId (status stays RECEIVED) just before the process parks
  // at the contract-signed catch event; gate on contractId so the message publish can correlate.
  const id = bru.getVar("applicationId");
  await pollApp(`/api/bike-leasing/${id}`, (b, s) => s === 200 && b && b.contractId != null);
}

assert {
  res.status: eq 202
}
