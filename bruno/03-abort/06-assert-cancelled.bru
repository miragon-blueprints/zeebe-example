meta {
  name: The leasing was cancelled and compensated
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/bike-leasing/{{applicationId}}
  body: none
  auth: none
}

script:pre-request {
  await new Promise((resolve) => setTimeout(resolve, 2500));
}

assert {
  res.status: eq 200
  res.body.status: eq CANCELLED
}
