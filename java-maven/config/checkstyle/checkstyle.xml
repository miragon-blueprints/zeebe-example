<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  The two source-structure rules ArchUnit cannot express: it reads bytecode, where imports and the
  file layout are gone. Checkstyle reads the source. See docs/adr/0007.
  The generated adapter/process package is excluded via the maven-checkstyle-plugin <excludes>.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <module name="TreeWalker">
        <module name="OneTopLevelClass"/>

        <module name="AvoidStarImport">
            <property name="excludes" value="java.util"/>
        </module>
    </module>
</module>
