<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_bike_order" targetNamespace="http://miragon.io/miravelo/bike-order" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_LeasingRequestReceived" name="miravelo.leasingRequestReceived" />
  <bpmn:message id="Message_ContractSigned" name="miravelo.contractSigned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_HandoverReported" name="miravelo.handoverReported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ApplicationWithdrawn" name="miravelo.applicationWithdrawn">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ApplicationInvalid" name="Application_Invalid" errorCode="applicationInvalid" />
  <bpmn:escalation id="Escalation_ContractNotSigned" name="Contract_Not_Signed" escalationCode="contractNotSigned" />
  <bpmn:process id="bikeLeasingProcess" name="MiraVelo Bike Leasing" isExecutable="true">
    <bpmn:startEvent id="startEvent_leasingRequestReceived" name="Leasing request received">
      <bpmn:extensionElements>
        <!-- The message start event injects these variables via the published message. The self-mapping
             output declarations make them available to bpmn-to-code as typed process variables. -->
        <zeebe:ioMapping>
          <zeebe:output source="=applicationId" target="applicationId" />
          <zeebe:output source="=bikeId" target="bikeId" />
          <zeebe:output source="=monthlyNetIncome" target="monthlyNetIncome" />
          <zeebe:output source="=age" target="age" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_receivedToValidate</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0233gqq" messageRef="Message_LeasingRequestReceived" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="serviceTask_orderBike" name="Order bike from dealer">
      <bpmn:extensionElements>
        <!-- Incident demo: the order step is its own retryable job. retries="3" makes the
             orderBikeWorker fail-and-retry the job (10s backoff, set in the worker) instead of letting
             it die, so the countdown is visible in Operate and Zeebe raises an incident on this task
             once the retries hit 0 (~20s). Reproduce it with the 06-incident-demo Bruno collection
             (poison bike id BIKE-FAIL). -->
        <zeebe:taskDefinition type="miravelo.orderBike" retries="3" />
        <!-- Result variables the orderBike worker writes. -->
        <zeebe:ioMapping>
          <zeebe:output source="=orderId" target="orderId" />
          <zeebe:output source="=bikeAvailable" target="bikeAvailable" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_bikeSourceToOrder</bpmn:incoming>
      <bpmn:outgoing>flow_orderToBikeAvailable</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="serviceTask_cancelPolicy" name="Cancel policy" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.cancelPolicy" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_applicationRejected" name="Application rejected">
      <bpmn:incoming>flow_sendRejectionToRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="event_handoverReported" name="Handover reported">
      <bpmn:incoming>flow_joinToHandover</bpmn:incoming>
      <bpmn:outgoing>flow_handoverToWithdrawalPeriod</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1m0s1ya" messageRef="Message_HandoverReported" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="endEvent_leasingActive" name="Leasing active">
      <bpmn:incoming>flow_activateToActive</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_sendRejection" name="Send rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.sendRejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_rejectionJoined</bpmn:incoming>
      <bpmn:outgoing>flow_sendRejectionToRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_rejectionJoin">
      <bpmn:incoming>flow_invalidToRejectionJoin</bpmn:incoming>
      <bpmn:incoming>flow_notSolventToRejectionJoin</bpmn:incoming>
      <bpmn:incoming>flow_notSignedToRejectionJoin</bpmn:incoming>
      <bpmn:outgoing>flow_rejectionJoined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_rejectionJoined" sourceRef="gateway_rejectionJoin" targetRef="serviceTask_sendRejection" />
    <bpmn:serviceTask id="serviceTask_validateApplication" name="Validate application">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.validateApplication" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_receivedToValidate</bpmn:incoming>
      <bpmn:outgoing>flow_validateToCheckCredit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway_isSolvent" name="Solvent?" default="flow_solventToConcludeContract">
      <bpmn:incoming>flow_checkCreditToSolvent</bpmn:incoming>
      <bpmn:outgoing>flow_solventToConcludeContract</bpmn:outgoing>
      <bpmn:outgoing>flow_notSolventToRejectionJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="businessRuleTask_checkCreditRating" name="Check credit rating">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="checkCreditRating" resultVariable="solvent" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_validateToCheckCredit</bpmn:incoming>
      <bpmn:outgoing>flow_checkCreditToSolvent</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:subProcess id="subProcess_concludeContract" name="Conclude contract">
      <bpmn:incoming>flow_solventToConcludeContract</bpmn:incoming>
      <bpmn:outgoing>flow_concludeToFork</bpmn:outgoing>
      <bpmn:startEvent id="startEvent_customerEligible" name="Customer eligible">
        <bpmn:outgoing>flow_eligibleToSendContract</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="flow_eligibleToSendContract" sourceRef="startEvent_customerEligible" targetRef="serviceTask_sendContract" />
      <bpmn:sequenceFlow id="flow_sendContractToAwaitSignature" sourceRef="serviceTask_sendContract" targetRef="gateway_awaitSignature" />
      <bpmn:eventBasedGateway id="gateway_awaitSignature">
        <bpmn:incoming>flow_sendContractToAwaitSignature</bpmn:incoming>
        <bpmn:outgoing>flow_awaitToContractSigned</bpmn:outgoing>
        <bpmn:outgoing>flow_awaitToSignatureDeadline</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="event_contractSigned" name="Contract signed">
        <bpmn:incoming>flow_awaitToContractSigned</bpmn:incoming>
        <bpmn:outgoing>flow_contractSignedToValid</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1s3mj11" messageRef="Message_ContractSigned" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="flow_awaitToContractSigned" sourceRef="gateway_awaitSignature" targetRef="event_contractSigned" />
      <bpmn:endEvent id="endEvent_contractValid" name="Contract valid">
        <bpmn:incoming>flow_contractSignedToValid</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="flow_contractSignedToValid" sourceRef="event_contractSigned" targetRef="endEvent_contractValid" />
      <bpmn:intermediateCatchEvent id="event_signatureDeadline" name="14 days">
        <bpmn:incoming>flow_awaitToSignatureDeadline</bpmn:incoming>
        <bpmn:outgoing>flow_signatureDeadlineToNotSigned</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_0hpbdck">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="flow_awaitToSignatureDeadline" sourceRef="gateway_awaitSignature" targetRef="event_signatureDeadline" />
      <bpmn:sequenceFlow id="flow_signatureDeadlineToNotSigned" sourceRef="event_signatureDeadline" targetRef="endEvent_notSigned" />
      <bpmn:endEvent id="endEvent_notSigned" name="Not signed">
        <bpmn:incoming>flow_signatureDeadlineToNotSigned</bpmn:incoming>
        <bpmn:escalationEventDefinition id="EscalationEventDefinition_0wpbfeq" escalationRef="Escalation_ContractNotSigned" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="serviceTask_sendContract" name="Send contract">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="miravelo.sendContract" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow_eligibleToSendContract</bpmn:incoming>
        <bpmn:outgoing>flow_sendContractToAwaitSignature</bpmn:outgoing>
      </bpmn:serviceTask>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="flow_reminderToSendMail" sourceRef="event_signatureReminder" targetRef="serviceTask_sendReminderMail" />
    <bpmn:sequenceFlow id="flow_sendMailToReminded" sourceRef="serviceTask_sendReminderMail" targetRef="endEvent_prospectReminded" />
    <bpmn:parallelGateway id="gateway_fork">
      <bpmn:incoming>flow_concludeToFork</bpmn:incoming>
      <bpmn:outgoing>flow_forkToBikeSource</bpmn:outgoing>
      <bpmn:outgoing>flow_forkToInsurance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="gateway_join">
      <bpmn:incoming>flow_insuranceToJoin</bpmn:incoming>
      <bpmn:incoming>flow_bikeAvailableToJoin</bpmn:incoming>
      <bpmn:outgoing>flow_joinToHandover</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gateway_bikeAvailable" name="Bike available?" default="flow_bikeAvailableToJoin">
      <bpmn:incoming>flow_orderToBikeAvailable</bpmn:incoming>
      <bpmn:outgoing>flow_bikeAvailableToJoin</bpmn:outgoing>
      <bpmn:outgoing>flow_bikeUnavailableToClarify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="userTask_clarifyAlternative" name="Clarify alternative with customer">
      <bpmn:documentation>Completable two ways: a human via the deployed Camunda Form (Tasklist), or a client via POST /api/bike-leasing/{id}/clarify-alternative. The REST path is the recommended one — it routes through the domain (persisting the chosen alternative bike on the aggregate) before completing the task, so the captured data actually reaches the domain model. See "Clarify return with supplier" in cancel-bike-order.bpmn for the form-only anti-pattern where data never leaves the process.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <!-- The Camunda Form still renders in the Tasklist for the human completion path. -->
        <zeebe:formDefinition formId="clarifyAlternativeForm" />
        <!-- The decision the task produces; declared for bpmn-to-code. -->
        <zeebe:ioMapping>
          <zeebe:output source="=alternativeFound" target="alternativeFound" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_bikeUnavailableToClarify</bpmn:incoming>
      <bpmn:outgoing>flow_clarifyToAlternativeFound</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_alternativeFound" name="Alternative found?" default="flow_alternativeFoundToBikeSource">
      <bpmn:incoming>flow_clarifyToAlternativeFound</bpmn:incoming>
      <bpmn:outgoing>flow_alternativeFoundToBikeSource</bpmn:outgoing>
      <bpmn:outgoing>flow_noAlternativeToReversal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gateway_bikeSourceJoin">
      <bpmn:incoming>flow_forkToBikeSource</bpmn:incoming>
      <bpmn:incoming>flow_alternativeFoundToBikeSource</bpmn:incoming>
      <bpmn:outgoing>flow_bikeSourceToOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="event_triggerReversal" name="Trigger reversal">
      <bpmn:incoming>flow_noAlternativeToReversal</bpmn:incoming>
      <bpmn:outgoing>flow_reversalToContractCancelled</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1acwjf2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="serviceTask_cancelContract" name="Cancel contract" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.cancelContract" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:callActivity id="callActivity_cancelBikeOrder" name="Cancel bike order" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="cancelBikeOrder" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=applicationId" target="applicationId" />
          <zeebe:input source="=orderId" target="orderId" />
          <zeebe:input source="=bikeId" target="bikeId" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:serviceTask id="serviceTask_issueInsurancePolicy" name="Issue insurance policy">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.issueInsurancePolicy" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_forkToInsurance</bpmn:incoming>
      <bpmn:outgoing>flow_insuranceToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="event_withdrawalPeriodElapsed" name="Await end of withdrawal period">
      <bpmn:incoming>flow_handoverToWithdrawalPeriod</bpmn:incoming>
      <bpmn:outgoing>flow_withdrawalElapsedToActive</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0j3mkdd">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="event_compensateContract" name="Compensate contract" attachedToRef="subProcess_concludeContract">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_0v0vumq" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_contractNotSigned" name="Contract not signed" attachedToRef="subProcess_concludeContract">
      <bpmn:outgoing>flow_notSignedToRejectionJoin</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationEventDefinition_1rt6mgy" escalationRef="Escalation_ContractNotSigned" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_applicationInvalid" name="Application&#10;invalid" attachedToRef="serviceTask_validateApplication">
      <bpmn:outgoing>flow_invalidToRejectionJoin</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1puuwjw" errorRef="Error_ApplicationInvalid" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_compensateInsurance" name="Compensate policy" attachedToRef="serviceTask_issueInsurancePolicy">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1qc5iwc" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="event_compensateOrder" name="Compensate order" attachedToRef="serviceTask_orderBike">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_1eokj6r" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_receivedToValidate" sourceRef="startEvent_leasingRequestReceived" targetRef="serviceTask_validateApplication" />
    <bpmn:sequenceFlow id="flow_bikeSourceToOrder" sourceRef="gateway_bikeSourceJoin" targetRef="serviceTask_orderBike" />
    <bpmn:sequenceFlow id="flow_orderToBikeAvailable" sourceRef="serviceTask_orderBike" targetRef="gateway_bikeAvailable" />
    <bpmn:sequenceFlow id="flow_sendRejectionToRejected" sourceRef="serviceTask_sendRejection" targetRef="endEvent_applicationRejected" />
    <bpmn:sequenceFlow id="flow_joinToHandover" sourceRef="gateway_join" targetRef="event_handoverReported" />
    <bpmn:sequenceFlow id="flow_handoverToWithdrawalPeriod" sourceRef="event_handoverReported" targetRef="event_withdrawalPeriodElapsed" />
    <bpmn:sequenceFlow id="flow_withdrawalElapsedToActive" sourceRef="event_withdrawalPeriodElapsed" targetRef="serviceTask_activateLeasing" />
    <bpmn:sequenceFlow id="flow_activateToActive" sourceRef="serviceTask_activateLeasing" targetRef="endEvent_leasingActive" />
    <bpmn:serviceTask id="serviceTask_activateLeasing" name="Activate leasing">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.activateLeasing" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_withdrawalElapsedToActive</bpmn:incoming>
      <bpmn:outgoing>flow_activateToActive</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_invalidToRejectionJoin" sourceRef="event_applicationInvalid" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_notSolventToRejectionJoin" name="No" sourceRef="gateway_isSolvent" targetRef="gateway_rejectionJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(solvent)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_notSignedToRejectionJoin" sourceRef="event_contractNotSigned" targetRef="gateway_rejectionJoin" />
    <bpmn:sequenceFlow id="flow_validateToCheckCredit" sourceRef="serviceTask_validateApplication" targetRef="businessRuleTask_checkCreditRating" />
    <bpmn:sequenceFlow id="flow_checkCreditToSolvent" sourceRef="businessRuleTask_checkCreditRating" targetRef="gateway_isSolvent" />
    <bpmn:sequenceFlow id="flow_solventToConcludeContract" sourceRef="gateway_isSolvent" targetRef="subProcess_concludeContract" />
    <bpmn:sequenceFlow id="flow_concludeToFork" sourceRef="subProcess_concludeContract" targetRef="gateway_fork" />
    <bpmn:sequenceFlow id="flow_forkToBikeSource" sourceRef="gateway_fork" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="flow_forkToInsurance" sourceRef="gateway_fork" targetRef="serviceTask_issueInsurancePolicy" />
    <bpmn:sequenceFlow id="flow_insuranceToJoin" sourceRef="serviceTask_issueInsurancePolicy" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_bikeAvailableToJoin" name="Yes" sourceRef="gateway_bikeAvailable" targetRef="gateway_join" />
    <bpmn:sequenceFlow id="flow_bikeUnavailableToClarify" name="No" sourceRef="gateway_bikeAvailable" targetRef="userTask_clarifyAlternative">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(bikeAvailable)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_clarifyToAlternativeFound" sourceRef="userTask_clarifyAlternative" targetRef="gateway_alternativeFound" />
    <bpmn:sequenceFlow id="flow_alternativeFoundToBikeSource" name="Yes" sourceRef="gateway_alternativeFound" targetRef="gateway_bikeSourceJoin" />
    <bpmn:sequenceFlow id="flow_noAlternativeToReversal" name="No" sourceRef="gateway_alternativeFound" targetRef="event_triggerReversal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(alternativeFound)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_reversalToContractCancelled" sourceRef="event_triggerReversal" targetRef="endEvent_contractCancelled" />
    <bpmn:endEvent id="endEvent_contractCancelled" name="Contract cancelled">
      <bpmn:incoming>flow_reversalToContractCancelled</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_04n84yk" />
    </bpmn:endEvent>
    <bpmn:subProcess id="subProcess_applicationWithdrawn" name="Application withdrawn" triggeredByEvent="true">
      <bpmn:startEvent id="startEvent_applicationWithdrawn" name="Request withdrawn">
        <bpmn:outgoing>flow_withdrawnToReverse</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Msg_AntragZurueckgezogen_d" messageRef="Message_ApplicationWithdrawn" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="event_reverseApplication" name="Reverse application">
        <bpmn:incoming>flow_withdrawnToReverse</bpmn:incoming>
        <bpmn:outgoing>flow_reverseToSendConfirmation</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="CompensateEventDefinition_01xv6ab" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="flow_withdrawnToReverse" sourceRef="startEvent_applicationWithdrawn" targetRef="event_reverseApplication" />
      <bpmn:sequenceFlow id="flow_reverseToSendConfirmation" sourceRef="event_reverseApplication" targetRef="serviceTask_sendCancellationConfirmation" />
      <bpmn:sequenceFlow id="flow_confirmationToCancelled" sourceRef="serviceTask_sendCancellationConfirmation" targetRef="endEvent_applicationCancelled" />
      <bpmn:serviceTask id="serviceTask_sendCancellationConfirmation" name="Send cancellation confirmation">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="miravelo.sendCancellationConfirmation" />
        </bpmn:extensionElements>
        <bpmn:incoming>flow_reverseToSendConfirmation</bpmn:incoming>
        <bpmn:outgoing>flow_confirmationToCancelled</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="endEvent_applicationCancelled" name="Leasing cancelled">
        <bpmn:incoming>flow_confirmationToCancelled</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="event_signatureReminder" name="7 days" cancelActivity="false" attachedToRef="subProcess_concludeContract">
      <bpmn:outgoing>flow_reminderToSendMail</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="serviceTask_sendReminderMail" name="Send reminder mail">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="miravelo.sendReminderMail" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_reminderToSendMail</bpmn:incoming>
      <bpmn:outgoing>flow_sendMailToReminded</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_prospectReminded" name="Prospect reminded">
      <bpmn:incoming>flow_sendMailToReminded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_0reycrf" associationDirection="One" sourceRef="event_compensateInsurance" targetRef="serviceTask_cancelPolicy" />
    <bpmn:association id="Association_1q9i1wm" associationDirection="One" sourceRef="event_compensateContract" targetRef="serviceTask_cancelContract" />
    <bpmn:association id="Association_185chbk" associationDirection="One" sourceRef="event_compensateOrder" targetRef="callActivity_cancelBikeOrder" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="bikeLeasingProcess">
      <bpmndi:BPMNShape id="Event_1b9ojt0_di" bpmnElement="startEvent_leasingRequestReceived">
        <dc:Bounds x="72" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
